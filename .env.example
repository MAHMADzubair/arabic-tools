# ─── Site URL ────────────────────────────────────────────────────────────────
# Production domain. Change this ONE variable to point the site at a custom domain.
# Fallback (when not set): https://arabic-tools-xi.vercel.app
NEXT_PUBLIC_SITE_URL=https://arabic-tools-xi.vercel.app

# ─── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Google Search Console verification (optional) ───────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
